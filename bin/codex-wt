#!/usr/bin/env bash
# codex-wt — run Codex (newest model, highest reasoning effort, fast tier,
# full-auto) in an isolated git worktree. Thin wrapper around `ai`.
#   codex-wt "..."   ==   ai wt codex "..."
# For the same setup without a worktree, run:  ai codex "..."
set -euo pipefail

src="${BASH_SOURCE[0]}"
while [ -h "$src" ]; do
  dir="$(cd -P "$(dirname "$src")" >/dev/null 2>&1 && pwd)"
  src="$(readlink "$src")"
  case "$src" in
    /*) ;;
    *) src="$dir/$src" ;;
  esac
done
dir="$(cd -P "$(dirname "$src")" >/dev/null 2>&1 && pwd)"

exec "$dir/ai" wt --agent codex "$@"
