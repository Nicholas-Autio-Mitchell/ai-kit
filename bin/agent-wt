#!/usr/bin/env bash
# agent-wt — back-compat wrapper: `ai` in worktree mode.
#   agent-wt <codex|claude> "..."   ==   ai wt <codex|claude> "..."
# Pass --here to fall back to in-place mode.
set -euo pipefail

src="${BASH_SOURCE[0]}"
while [ -h "$src" ]; do
  dir="$(cd -P "$(dirname "$src")" >/dev/null 2>&1 && pwd)"
  src="$(readlink "$src")"
  case "$src" in
    /*) ;;
    *) src="$dir/$src" ;;
  esac
done
dir="$(cd -P "$(dirname "$src")" >/dev/null 2>&1 && pwd)"

exec "$dir/ai" wt "$@"
