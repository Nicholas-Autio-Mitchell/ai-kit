#!/usr/bin/env bash
# claude-wt — run Claude (latest Opus, max effort / ultracode, full-auto) in an
# isolated git worktree. Thin wrapper around `ai`.
#   claude-wt "..."   ==   ai wt claude "..."
# For the same setup without a worktree, run:  ai claude "..."
set -euo pipefail

src="${BASH_SOURCE[0]}"
while [ -h "$src" ]; do
  dir="$(cd -P "$(dirname "$src")" >/dev/null 2>&1 && pwd)"
  src="$(readlink "$src")"
  case "$src" in
    /*) ;;
    *) src="$dir/$src" ;;
  esac
done
dir="$(cd -P "$(dirname "$src")" >/dev/null 2>&1 && pwd)"

exec "$dir/ai" wt --agent claude "$@"
